# Provision an isolated claim_db; use credentials supplied by your local environment.
DB_URL=jdbc:postgresql://localhost:5432/claim_db
DB_USERNAME=ems
DB_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
CLAIM_CURRENCY=LKR

# Local MinIO: supply local credentials; production can use the AWS default credential chain.
STORAGE_ENABLED=true
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
