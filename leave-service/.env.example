# Local development only. Copy to .env.development; never commit real credentials.
# The same variables are required in staging/production secret configuration.
# db/init.sql creates leave_db on a fresh local Compose volume.
DB_URL=jdbc:postgresql://localhost:5432/leave_db
DB_USERNAME=ems
DB_PASSWORD=ems_local_dev
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ems
RABBITMQ_PASSWORD=ems_local_dev
