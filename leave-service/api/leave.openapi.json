  "components": {
    "schemas": {
      "LeaveType": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "TypeInput": {
        "type": "object",
        "required": [
          "code",
          "name",
          "active"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Allocation": {
        "type": "object",
        "required": [
          "employeeId",
          "typeId",
          "year",
          "days",
          "reason"
        ],
        "properties": {
          "employeeId": {
            "type": "integer",
            "minimum": 1
          },
          "typeId": {
            "type": "string",
            "format": "uuid"
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 9999
          },
          "days": {
            "type": "string",
            "pattern": "^[0-9]{1,7}(\\.[0-9]{1,2})?$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Adjustment": {
        "type": "object",
        "required": [
          "days",
          "idempotencyKey",
          "reason"
        ],
        "properties": {
          "days": {
            "type": "string",
            "pattern": "^-?[0-9]{1,7}(\\.[0-9]{1,2})?$",
            "description": "Nonzero signed decimal string"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "id",
          "employeeId",
          "typeId",
          "typeName",
          "year",
          "entitlement",
          "adjustments",
          "taken",
          "reserved",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeId": {
            "type": "integer"
          },
          "typeId": {
            "type": "string",
            "format": "uuid"
          },
          "typeName": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "entitlement": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Fixed decimal days; exactly two fraction digits."
          },
          "adjustments": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Fixed decimal days; exactly two fraction digits."
          },
          "taken": {
            "type": "string",
