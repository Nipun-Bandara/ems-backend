  "components": {
    "schemas": {
      "Entry": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "projectId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "date",
          "projectId",
          "minutes",
          "description"
        ]
      },
      "Create": {
        "type": "object",
        "properties": {
          "weekStart": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "weekStart"
        ]
      },
      "Save": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "maxItems": 500
          }
        },
        "required": [
          "version",
          "entries"
        ]
      },
      "Submit": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "version"
        ]
      },
      "Calendar": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          },
          "currentWeekStart": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "timezone",
          "currentWeekStart"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "eligibleDates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "required": [
          "id",
          "name",
          "eligibleDates"
        ]
      },
      "Sheet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employeeId": {
            "type": "integer",
            "format": "int64"
          },
          "weekStart": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "APPROVED",
              "REJECTED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdBy": {
            "type": "integer",
            "format": "int64"
          },
          "updatedBy": {
            "type": "integer",
            "format": "int64"
          },
          "submittedBy": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewedBy": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "reviewReason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "employeeId",
          "weekStart",
          "status",
          "version",
          "entries",
          "createdAt",
          "updatedAt",
          "submittedAt",
          "createdBy",
          "updatedBy",
          "submittedBy",
          "reviewedAt",
          "reviewedBy",
          "reviewReason"
        ]
      },
      "Employee": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "active"
        ]
      },
      "ProjectSnapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "teamId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "id",
          "teamId",
          "name",
          "deleted",
          "startDate",
          "endDate"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "member": {
            "type": "boolean"
          }
        },
        "required": [
          "teamId",
          "userId",
          "member"
        ]
      },
      "Backfill": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "employees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Employee"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSnapshot"
            }
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": [
          "asOf",
          "effectiveDate",
          "employees",
          "projects",
          "memberships"
        ]
      },
      "Error": {
