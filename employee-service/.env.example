# employee-service -- local development template.
#
#     cp .env.example .env.development
#
# Every variable below is referenced by src/main/resources/application-*.yml.
# Spring reads this file as a .properties file, so values are literal: do not
# quote them and do not leave trailing whitespace.
#
# The values here match docker-compose.yml at the repo root. They are local
# development defaults, not secrets -- never paste a real credential into
# this file, it is committed.

# --- Datasource (spring.datasource.*) -------------------------------------
# employee_db is created on first start by db/init.sql.
DB_URL=jdbc:postgresql://localhost:5432/employee_db
DB_USERNAME=ems
DB_PASSWORD=ems_local_dev

# --- RabbitMQ (spring.rabbitmq.*) -----------------------------------------
# employee.q subscribes to user.registered and user.verified.
# Matches the rabbitmq service in docker-compose.yml at the repo root; its
# management UI is at http://localhost:15672.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ems
RABBITMQ_PASSWORD=ems_local_dev

# --- S3 / MinIO ---------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
# Must be reachable by the browser; when containerized use minio:9000 above,
# and keep a browser-reachable address here. Signatures bind the hostname.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=ems_minio
STORAGE_SECRET_KEY=ems_local_dev
STORAGE_PATH_STYLE_ACCESS=true
STORAGE_ALLOWED_ORIGINS=http://localhost:3000
