# api-gateway -- local development template.
#
#     cp .env.example .env.development
#
# Every variable below is referenced by src/main/resources/application-*.yml.
# Spring reads this file as a .properties file, so values are literal: do not
# quote them and do not leave trailing whitespace.
#
# These are local development defaults, not secrets -- never paste a real
# credential into this file, it is committed.

# --- Downstream routes (spring.cloud.gateway.*) ---------------------------
# Where identity-service listens. 8081 is its server.port in application.yml.
IDENTITY_SERVICE_URL=http://localhost:8081

# --- CORS (globalcors + CorsConfig) ---------------------------------------
# Comma-separated origin list. 3000 is the Next.js dev server in ems-frontend.
ALLOWED_ORIGINS=http://localhost:3000

# --- JWT (app.security.jwt.secret) ----------------------------------------
# Base64-encoded HMAC key used to verify tokens minted by identity-service.
# Must be identical to JWT_SECRET in identity-service/.env.development.
# Generate your own with: openssl rand -base64 48
JWT_SECRET=ZW1zLWxvY2FsLWRldmVsb3BtZW50LW9ubHktbm90LWEtcmVhbC1zZWNyZXQtMDAwMQ==
