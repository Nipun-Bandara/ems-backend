# identity-service -- local development template.
#
#     cp .env.example .env.development
#
# Every variable below is referenced by src/main/resources/application-*.yml.
# Spring reads this file as a .properties file, so values are literal: do not
# quote them and do not leave trailing whitespace.
#
# The values here match docker-compose.yml at the repo root. They are local
# development defaults, not secrets -- never paste a real credential into
# this file, it is committed.

# --- Datasource (spring.datasource.*) -------------------------------------
# identity_db is created on first start by db/init.sql.
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USERNAME=ems
DB_PASSWORD=ems_local_dev

# --- JWT signing keys (app.security.jwt.*-key-path) -----------------------
# Tokens are signed RS256. The gateway verifies them against the public half,
# which this service publishes at /.well-known/jwks.json, so there is no
# secret to keep in step between the two modules any more.
#
# Both paths are optional in the development profile only: left unset, the
# service generates a keypair at startup and logs a warning. That keypair is
# gone on restart, which invalidates every token issued before it -- set the
# paths if you would rather stay logged in across restarts:
#
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#         -out identity-service/jwt-private.pem
#     openssl pkey -in identity-service/jwt-private.pem -pubout \
#         -out identity-service/jwt-public.pem
#
# Paths are resolved against the working directory the service is started
# from. Never commit the private key; *.pem is gitignored.
# JWT_PRIVATE_KEY_PATH=jwt-private.pem
# JWT_PUBLIC_KEY_PATH=jwt-public.pem

# Milliseconds. 900000 = 15 minutes.
JWT_EXPIRATION=900000

# Milliseconds. 604800000 = 7 days.
JWT_REFRESH_EXPIRATION=604800000
