# notification-service -- local development template.
#
#     cp .env.example .env.development
#
# Every variable below is referenced by src/main/resources/application-*.yml.
# Spring reads this file as a .properties file, so values are literal: do not
# quote them and do not leave trailing whitespace.
#
# The values here match docker-compose.yml at the repo root. They are local
# development defaults, not secrets -- never paste a real credential into
# this file, it is committed.

# --- Datasource (spring.datasource.*) -------------------------------------
# notification_db is created on first start by db/init.sql.
DB_URL=jdbc:postgresql://localhost:5432/notification_db
DB_USERNAME=ems
DB_PASSWORD=ems_local_dev

# --- RabbitMQ (spring.rabbitmq.*) -----------------------------------------
# The broker this service declares its queues on at startup. The exchange and
# queue names are not configurable -- they live in ems-common so every service
# agrees on them. This service's queue is notification.q, bound to ems.events
# on '#': it consumes the whole event stream and publishes nothing. Matches the
# rabbitmq service in docker-compose.yml at the repo root; its management UI is
# at http://localhost:15672.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ems
RABBITMQ_PASSWORD=ems_local_dev

# --- SMTP (spring.mail.*) -------------------------------------------------
# MailHog from docker-compose.yml at the repo root: it accepts every message,
# delivers none of them, and shows what it caught at http://localhost:8025.
# That is the whole point locally -- registering a test user must not put real
# mail in a real inbox.
#
# MailHog has no accounts and no TLS, hence auth and starttls off. A real relay
# needs both on, plus MAIL_USERNAME and MAIL_PASSWORD from the deployment
# platform.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Envelope sender on everything this service sends (app.mail.from). .local is
# reserved, so a message that escapes to a real MTA by mistake cannot be
# delivered or replied to.
MAIL_FROM=no-reply@ems.local
