  "components": {
    "schemas": {
      "UpdateEmployeeProfileRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9][0-9 ()-]{5,29}$",
            "nullable": true,
            "maxLength": 30
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "emergencyContactName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "emergencyContactPhone": {
            "type": "string",
            "pattern": "^\\+?[0-9][0-9 ()-]{5,29}$",
            "nullable": true,
            "maxLength": 30
          },
          "designationId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "reportingManagerUserId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          }
        }
      },
      "EmployeeProfile": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "phone",
          "dateOfBirth",
          "address",
          "emergencyContactName",
          "emergencyContactPhone",
          "designationId",
          "joinDate",
          "reportingManagerUserId",
          "userId",
          "username",
          "email",
          "status",
          "avatarUrl",
          "departmentId",
          "avatarObjectKey",
          "cvObjectKey"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "nullable": true
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9][0-9 ()-]{5,29}$",
            "nullable": true,
            "maxLength": 30
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "emergencyContactName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "emergencyContactPhone": {
            "type": "string",
            "pattern": "^\\+?[0-9][0-9 ()-]{5,29}$",
            "nullable": true,
            "maxLength": 30
          },
          "designationId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "reportingManagerUserId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "departmentId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "avatarObjectKey": {
            "type": "string",
            "nullable": true,
            "readOnly": true,
            "maxLength": 255
          },
          "cvObjectKey": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          }
        }
      },
      "EmployeeSkillRequest": {
        "type": "object",
        "required": [
          "name",
          "proficiency",
          "yearsOfExperience"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "proficiency": {
            "type": "string",
            "enum": [
              "BEGINNER",
              "INTERMEDIATE",
              "ADVANCED",
              "EXPERT"
            ]
          },
          "yearsOfExperience": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.1
          }
        }
      },
      "EmployeeSkill": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "name",
          "proficiency",
          "yearsOfExperience"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "proficiency": {
            "type": "string",
            "enum": [
              "BEGINNER",
              "INTERMEDIATE",
              "ADVANCED",
              "EXPERT"
            ]
          },
          "yearsOfExperience": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.1
          }
        }
      },
      "EmployeeEducationRequest": {
        "type": "object",
        "required": [
          "institution",
          "qualification",
          "startYear"
        ],
        "properties": {
          "institution": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "qualification": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "fieldOfStudy": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "startYear": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200
          },
          "endYear": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2200,
            "nullable": true
          },
          "grade": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          }
        }
      },
      "EmployeeEducation": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "institution",
          "qualification",
          "fieldOfStudy",
          "startYear",
          "endYear",
          "grade"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "institution": {
