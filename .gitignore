# Maven build output (the aggregator builds at the repo root too)
target/

# VS Code
.vscode/

# IntelliJ IDEA
.idea/

# Environment files (keep secrets out of git)
**/.env
**/.env.*

# ...except the committed templates, which hold only local-compose defaults.
!**/.env.example

# JWT signing keys (identity-service reads these from JWT_*_KEY_PATH)
*.pem